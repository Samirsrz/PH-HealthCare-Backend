model Schedule {
    id String @id @default(uuid())
    startDateTime DateTime
    endDateTime DateTime

    totalSlots Int
    availableSlots Int
    meetingLink String
    status ScheduleStatus @default(DRAFT)
  
     isDeleted Boolean @default(false)
     deletedAt DateTime?
     createdAt DateTime @default(now())
     updatedAt DateTime @updatedAt

     doctodId String
     doctor Doctor @relation(fields: [doctodId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    appointments Appointment[]
     @@unique([doctodId,startDateTime,endDateTime],name: "unique_scheduler")
     @@map("schedules")

}